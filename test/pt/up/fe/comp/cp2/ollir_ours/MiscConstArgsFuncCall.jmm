import ioPlus;
class ConstArgsFuncCall {

    public int func(int a, int b, int c){
        ioPlus.printResult(a);
        ioPlus.printResult(b);
        ioPlus.printResult(c);
        return 1;
    }

	public static void main(String[] args) {
        ConstArgsFuncCall c;
        int a;
        c = new ConstArgsFuncCall();
		a= c.func(10, 12, 11);
	}
}