import GetterAndSetter;
import io;

class NoArgsFuncCall {

    public static void main(String[] args) {
        NoArgsFuncCall f;
        GetterAndSetter gs;
        int res;

        f = new NoArgsFuncCall();
        gs = new GetterAndSetter();

        res = f.bar(gs);

        io.println(res);
    }

	public int bar(GetterAndSetter c) {
        int a;
		a = c.getA();
        return a;
	}

}