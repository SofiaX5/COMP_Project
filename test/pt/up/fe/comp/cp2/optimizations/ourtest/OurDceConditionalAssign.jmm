class OurDceConditionalAssign {
    public int testConditionalDce(boolean flag) {
        int y;
        y = 10; // Potentially dead
        if (flag) {
            y = 20; // Potentially dead
        } else {
            y = 30; // Potentially dead
        }
        return 100; // y is not used after the if-else, so assignments to y should be dead
    }
    public static void main(String[] args) {
    }
}