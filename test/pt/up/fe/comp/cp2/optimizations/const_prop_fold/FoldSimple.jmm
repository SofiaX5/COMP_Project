import io;



class Folding {

    public static void main(String[] args){
        int a;
        int b;
        int sum;
        int diff;
        int prod;
        int div;
        int mod;
        boolean c;
        boolean d;
        int result;

        a = 10;
        b = 20;
        sum = a + b;
        diff = a - b;
        prod = a * b;
        div = a / b;
        c = true;
        d = false;

        mod = a - (a / b);


        result = sum + diff + prod + div + mod;
}

}
