class NegationBooleanValid {
    public boolean foo() {
        boolean a;
        boolean b;
        boolean c;
        boolean result;

        a = true;
        b = false;

        // Test negation in various contexts
        c = !a;                    // Negate a variable
        result = !(a && b);        // Negate a complex expression

        if (!b) {                  // Negate in a condition
            result = !result;      // Negate a variable
        }
        else {}

        return !(result && !a);    // Nested negations
    }
}